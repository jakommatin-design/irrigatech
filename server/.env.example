# ============================================================
#  IRRIGA-TECH SERVER — Environment Configuration Template
#  Copy this file to .env and fill in your real credentials.
#  NEVER commit .env to version control.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret-string

# Local USB serial connection (leave SERIAL_PORT blank for vendor-based auto-detection)
# Windows example: COM3 (find the actual port in Device Manager)
# Linux example: /dev/ttyUSB0 or /dev/ttyACM0
SERIAL_PORT=
SERIAL_BAUD_RATE=9600

# ── Hosted ESP32 device ingestion (server only) ──────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use the same value in DEVICE_API_TOKEN on Railway and firmware/secrets.h.
DEVICE_API_TOKEN=replace-with-a-random-64-character-hex-token
# Must match owner_id for the account that owns the greenhouse in the app database.
DEVICE_OWNER_ID=replace-with-greenhouse-owner-id

# ── TiDB Cloud (MySQL-compatible distributed SQL) ───────────
TIDB_HOST=your-cluster.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your-tidb-username
TIDB_PASSWORD=your-tidb-password
TIDB_DATABASE=irrigatech
TIDB_SSL=true

# ── Google Gemini AI (Optional — offline rules engine works without it) ──
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ── Africa's Talking SMS Gateway (Optional — simulator works without it) ──
# Register at: https://account.africastalking.com
AT_USERNAME=sandbox
AT_API_KEY=your-africastalking-api-key
AT_SENDER_ID=IRRIGATECH

# ── Farmer Phone Recipient for Automated Post-Irrigation SMS ──
FARMER_PHONE=+254712345678

# ── Open-Meteo Weather (No key needed — free & open API) ──────
# Override GPS coords if your farm is not in Nanyuki, Kenya
WEATHER_LAT=-0.0167
WEATHER_LON=37.0728
# Cloudinary (server-side only; never expose API secret as a VITE_ or NEXT_PUBLIC_ variable)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
